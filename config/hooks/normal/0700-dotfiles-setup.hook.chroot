#!/bin/bash
set -euo pipefail

echo "=> [Hook] Installing dotfiles..."

if ! id -u akop >/dev/null 2>&1; then
    useradd -m -s /bin/zsh -u 1000 akop
fi

echo "akop ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/temp-build-sudo
chmod 0440 /etc/sudoers.d/temp-build-sudo

su - akop -c '
    set -euo pipefail
    echo "=> [Hook] Copy trusted taps/formulas from dotfiles..."
    mkdir -p "${HOME}/.homebrew"
    cp -r "${HOME}/.dotfiles/homebrew/." "${HOME}/.homebrew/"

    echo "=> [Hook] Execute dotfiles install script as $(whoami)"
    NONINTERACTIVE=1 bash "${HOME}/.dotfiles/install.sh"
'

rm /etc/sudoers.d/temp-build-sudo
