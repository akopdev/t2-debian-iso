#!/bin/bash
set -euo pipefail

echo "=> [Hook] Installing T2-specific audio profiles (t2-better-audio)..."

# Vendored from https://github.com/kekrby/t2-better-audio (install.sh), with
# its two irrelevant-for-us behaviors dropped:
#
# - The original re-execs itself via sudo whenever $USER != root, since it's
#   meant to be run interactively on an already-booted desktop by a normal
#   user. Chroot hooks already run as root, so that whole dance (saving
#   XDG_CONFIG_HOME to /tmp/user.txt, re-exec, cleanup) is skipped in favor
#   of just doing the actual file-copy steps directly.
# - The "delete old config files" prompt only matters when re-running the
#   script on an existing install with a previous version's files present.
#   This is a fresh chroot, so there's nothing to clean up.
#
# The actual payload - copying files/profile-sets and files/paths into
# whichever of /usr/share/alsa-card-profile/mixer (used by our PipeWire
# stack) or /usr/share/pulseaudio/alsa-mixer (used by PulseAudio, not
# installed here) exists, plus a udev rule - is preserved as-is.

workdir=$(mktemp -d)
curl -fsSL "https://github.com/kekrby/t2-better-audio/archive/refs/heads/main.tar.gz" | tar -xz -C "${workdir}" --strip-components=1

for dir in /usr/share/alsa-card-profile/mixer /usr/share/pulseaudio/alsa-mixer; do
	if [ -d "${dir}" ]; then
		cp -r "${workdir}/files/profile-sets" "${dir}/"
		cp -r "${workdir}/files/paths" "${dir}/"
	fi
done

cp "${workdir}/files/91-audio-custom.rules" /usr/lib/udev/rules.d/

rm -rf "${workdir}"

echo "=> [Hook] T2 audio profiles installed."
