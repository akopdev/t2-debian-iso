#!/bin/bash
set -euo pipefail

echo "=> [Hook] Installing dotfiles..."

# Half of this code could be removed if folks from the Homebrew community could add support for user level
# installation of flatpak packages . Instead, they hardcoded the `--system` flag into the extension itself 
# (see https://github.com/Homebrew/brew/blob/main/Library/Homebrew/bundle/extensions/flatpak.rb), so it requires
# root access for installation.
#
# To bypass this limitation in chroot, I have to spin up D-Bus service with polkitd. This is crazy, but it kind of works. 
# Once I decide on brew/flatpak alternative, I can rethink this approach.

if ! id -u akop >/dev/null 2>&1; then
    useradd -m -s /bin/zsh -u 1000 -G video,input akop
fi

echo "akop ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/temp-build-sudo
chmod 0440 /etc/sudoers.d/temp-build-sudo

_generated_machine_id=false
if [ ! -s /etc/machine-id ]; then
    dbus-uuidgen --ensure
    _generated_machine_id=true
fi

mkdir -p /run/dbus
dbus-daemon --system --fork

polkitd_bin="$(command -v polkitd || echo /usr/lib/policykit-1/polkitd)"
"${polkitd_bin}" --no-debug &
_polkitd_pid=$!

for _ in $(seq 1 20); do
    if busctl --system status org.freedesktop.PolicyKit1 >/dev/null 2>&1; then
        break
    fi
    sleep 0.25
done

# Shim flatpak to route through root to bypass uid 1000 chroot limitations
mv /usr/bin/flatpak /usr/bin/flatpak.real
cat > /usr/bin/flatpak <<'EOF'
#!/bin/bash
exec sudo -n /usr/bin/flatpak.real "$@"
EOF
chmod +x /usr/bin/flatpak

cleanup_dbus() {
    kill "${_polkitd_pid}" 2>/dev/null || true
    [ -f /run/dbus/pid ] && kill "$(cat /run/dbus/pid)" 2>/dev/null || true
    if [ "${_generated_machine_id}" = true ]; then
        : > /etc/machine-id
    fi
    mv -f /usr/bin/flatpak.real /usr/bin/flatpak 2>/dev/null || true
}
trap cleanup_dbus EXIT

su - akop -c '
    set -euo pipefail

    echo "=> [Hook] Adding Flathub remote for flatpak..."
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

    echo "=> [Hook] Copy trusted taps/formulas from dotfiles..."
    mkdir -p "${HOME}/.homebrew"
    cp -r "${HOME}/.dotfiles/homebrew/." "${HOME}/.homebrew/"

    echo "=> [Hook] Execute dotfiles install script as $(whoami)"
    NONINTERACTIVE=1 bash "${HOME}/.dotfiles/install.sh"
'

rm /etc/sudoers.d/temp-build-sudo
