#!/bin/bash
set -euo pipefail

echo "=> [Hook] Building xkb-switch from source..."

_pkgs_before="$(dpkg-query -W -f='${Package}\n' | sort)"

apt-get update -qq
apt-get install -y -qq --no-install-recommends \
    build-essential cmake pkg-config git libx11-dev libxkbfile-dev

_pkgs_after="$(dpkg-query -W -f='${Package}\n' | sort)"
_pkgs_new="$(comm -13 <(echo "${_pkgs_before}") <(echo "${_pkgs_after}"))"

_src_dir="$(mktemp -d)"
git clone --depth 1 https://github.com/sergei-mironov/xkb-switch.git "${_src_dir}"

cmake -S "${_src_dir}" -B "${_src_dir}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${_src_dir}/build" -j"$(nproc)"
cmake --install "${_src_dir}/build"
ldconfig

rm -rf "${_src_dir}"

if [ -n "${_pkgs_new}" ]; then
    # shellcheck disable=SC2086
    apt-get purge -y -qq ${_pkgs_new}
fi
apt-get autoremove -y -qq
rm -rf /var/lib/apt/lists/*
